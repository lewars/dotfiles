# .bash_profile
#
# {{ full_name }}

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
     # shellcheck disable=SC1090
     . ~/.bashrc
fi
{% set default_path = '$HOME/bin:$HOME/.local/bin' %}

{% if ansible_os_family == 'RedHat' %}

# Go environment variables
export GOPATH="$HOME/go"
export GOBIN="$GOPATH/bin"
export PATH="$PATH:$GOBIN"

{% elif ansible_os_family == 'Darwin' %}
export PATH=$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin:/usr/local/opt/grep/libexec/gnubin:$GOBIN:/usr/local/google-cloud-sdk/bin:$PATH:{{ default_path }}:
{% endif %}
export PAGER=less
export LESS=-iXMr
export EDITOR=emacs
export VISUAL=$EDITOR
export LSCOLORS=exgxcxfxbxegedabagacad
export CLICOLOR=1

# create tmp dir if not present with private permissions
export TMPDIR=$HOME/tmp
[ ! -d "$TMPDIR" ] && mkdir -m 700 -p "$TMPDIR" || chmod 700 "$TMPDIR"

{% if ansible_os_family == 'Darwin' %}
test -e "${HOME}/.iterm2_shell_integration.bash" && source "${HOME}/.iterm2_shell_integration.bash"
{% endif %}
