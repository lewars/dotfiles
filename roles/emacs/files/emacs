;; --- Custom Helper Functions for Capture Templates ---
(defun le/org-roam-select-node (prompt &optional tags)
  "Prompt user to select a single Org-roam node with an optional list of TAGS."
  (let* ((parsed-tags (when (and tags (stringp tags) (not (string-empty-p tags)))
                        (split-string tags "," t "[ ]*")))
         (node (condition-case err
                   (org-roam-node-read prompt parsed-tags)
                 (error
                  (message "Error in org-roam-node-read: %s" err)
                  nil)
                 (quit nil))))
    (if node
        (format "[[id:%s][%s]]" (org-roam-node-id node) (org-roam-node-title node))
      "")))  ; Return empty string instead of nil

(defun le/org-roam-select-nodes (prompt &optional tags)
  "Prompt user to select multiple Org-roam nodes with an optional list of TAGS."
  (let* ((parsed-tags (when (and tags (stringp tags) (not (string-empty-p tags)))
                        (split-string tags "," t "[ ]*")))
         (all-nodes (org-roam-node-list))
         (available-nodes (if parsed-tags
                              (cl-remove-if-not
                               (lambda (node)
                                 (cl-every (lambda (tag)
                                             (member tag (org-roam-node-tags node)))
                                           parsed-tags))
                               all-nodes)
                            all-nodes))
         (node-titles (mapcar #'org-roam-node-title available-nodes))
         (selected-titles (condition-case err
                              (completing-read-multiple prompt node-titles nil t)
                            (error
                             (message "Error in completing-read-multiple: %s" err)
                             nil)
                            (quit nil))))
    (if selected-titles
        (mapconcat (lambda (title)
                     (let ((node (cl-find title available-nodes :key #'org-roam-node-title :test #'string=)))
                       (when node
                         (format "[[id:%s][%s]]" (org-roam-node-id node) (org-roam-node-title node)))))
                   selected-titles
                   " ")
      "")))

