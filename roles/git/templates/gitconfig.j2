[init]
        defaultBranch = main
[user]
        name = {{ full_name }}
        email = {{ git_email }}
        signingkey = {{ git_ssh_signing_key | default('~/.ssh/gh_sk.pub') }}
[alias]
        a = add
        st = status
        s = status
        co = checkout
        cob = checkout -b
        c = checkout
        ci = commit
        noff = merge --no-ff
        plr = pull --rebase
        amend = commit --amend
        wip = commit --no-verify -am "WIP"
        br = branch
        rn = branch -m
        # diff-so-fancy
        # https://github.com/so-fancy/diff-so-fancy/#usage
        df = "!f() { [ -z \"$GIT_PREFIX\" ] || cd \"$GIT_PREFIX\" && git diff --color \"$@\" | diff-so-fancy  | less --tabs=4 -RFX; }; f"
        dfs = df --staged
        # Get changes for a single commit
        dfc = "!dfc() { git df $1^ $1; }; dfc"

        please = push --force-with-lease
        publish = "!git push -u origin $(git rev-parse --abbrev-ref HEAD)"
        # publish current branch
        publish = "!f() { git push -u ${1:-origin} $(git rev-parse --abbrev-ref HEAD); }; f"

        # http://gggritso.com/human-git-aliases
        unstage = reset -q HEAD --
        discard = checkout --
        uncommit = reset --mixed HEAD~

        l = log --graph --decorate --oneline --abbrev-commit --all
        h = log --graph --decorate --oneline --abbrev-commit

        issues = !gh issue list --web
        url = "!f() { sha=$(git rev-parse ${1:-HEAD}); gh browse --commit \"$sha\"; }; f"

        # Copy current branch name to clipboard (macOS only)
        cb = "!git rev-parse --abbrev-ref HEAD | tr -d '\n' | pbcopy"

        remote-branches = "!f() { git ls-remote --heads ${1:origin} | sed 's?.*refs/heads/??'; }; f "

        pre = !sh -c 'git push origin +master:precommit_$(git config --get user.email | sed s,@.*,,)'
[color]
        diff = auto
        status = auto
        branch = auto
        ui = true
[core]
        editor = emacs -nw
        excludesfile = ~/.gitignore_global
[status]
        short = true

[apply]
        whitespace = warn
# [mergetool]
#         keepBackup = false
# [difftool]
#         prompt = false
[commit]
        gpgsign = true
[tag]
        gpgSign = true
[push]
        default = simple
        followTags = true
        autoSetupRemote = true
[github]
        user = {{ git_user }}
[filter "lfs"]
        required = true
        clean = git-lfs clean -- %f
        smudge = git-lfs smudge -- %f
        process = git-lfs filter-process
[hub]
        protocol = https
[gpg]
	format = ssh
{% if git_ssh_signing_enabled | default(true) %}
[gpg "ssh"]
	program = {{ git_ssh_wrapper_path }}
{% if git_ssh_allowed_signers_file is defined and git_ssh_allowed_signers_file %}
	allowedSignersFile = {{ git_ssh_allowed_signers_file }}
{% endif %}
{% endif %}
